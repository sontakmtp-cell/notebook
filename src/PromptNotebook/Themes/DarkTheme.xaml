<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Bảng màu Dark Mode tối giản, hiện đại, độ tương phản cao -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#18181B" />
    <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="#1F1F23" />
    <SolidColorBrush x:Key="EditorBackgroundBrush" Color="#141417" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#27272C" />
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#323239" />
    <SolidColorBrush x:Key="SurfaceSelectedBrush" Color="#2B3A55" />
    <SolidColorBrush x:Key="BorderSubtleBrush" Color="#33333B" />
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="#F4F4F6" />
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#A1A1AA" />
    <SolidColorBrush x:Key="AccentBrush" Color="#3B82F6" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#2563EB" />
    <SolidColorBrush x:Key="FavoriteStarBrush" Color="#F59E0B" />
    <SolidColorBrush x:Key="DangerBrush" Color="#EF4444" />
    <SolidColorBrush x:Key="BadgeBackgroundBrush" Color="#2E323D" />
