<Window x:Class="PromptNotebook.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ae="http://icsharpcode.net/sharpdevelop/avalonedit"
        Title="Notebook" Icon="/PromptNotebook;component/Assets/Notebook.ico" MinWidth="720" MinHeight="400"
        FontFamily="Segoe UI" FontSize="13" UseLayoutRounding="True"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}"
        WindowStartupLocation="CenterScreen" Closing="OnClosing"
        SourceInitialized="OnSourceInitialized" AllowDrop="True"
        PreviewDragOver="FilesDragOver" PreviewDrop="FilesDrop">
    <Window.InputBindings>
        <KeyBinding Key="S" Modifiers="Control" Command="ApplicationCommands.Save" />
        <KeyBinding Key="H" Modifiers="Control" Command="ApplicationCommands.Replace" />
    </Window.InputBindings>
    <Window.CommandBindings>
        <CommandBinding Command="ApplicationCommands.Save" Executed="SaveCommandExecuted" />
        <CommandBinding Command="ApplicationCommands.Replace" Executed="ReplaceCommandExecuted" />
    </Window.CommandBindings>
    <Window.Resources>
        <Style x:Key="Icon" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="ToolButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Margin" Value="1,0" />
        </Style>
        <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource ToolButton}">
            <Setter Property="MinWidth" Value="32" />
        </Style>
        <Style x:Key="StatusText" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,18,0" />
        </Style>
        <Style x:Key="FindField" TargetType="TextBox">
            <Setter Property="Width" Value="235" />
            <Setter Property="Margin" Value="0,0,5,0" />
            <Setter Property="Padding" Value="7,5" />
            <Setter Property="Background" Value="{DynamicResource EditorBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="CaretBrush" Value="{DynamicResource PrimaryTextBrush}" />
        </Style>
        <Style x:Key="FindLabel" TargetType="TextBlock">
            <Setter Property="Width" Value="69" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="52" />
            <RowDefinition Height="43" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="31" />
        </Grid.RowDefinitions>

        <Border BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,0,0,1" Padding="13,0">
            <DockPanel LastChildFill="False">
                <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" VerticalAlignment="Center"
                        ToolTip="Cài đặt" AutomationProperties.Name="Cài đặt" Click="SettingsClick">
                    <TextBlock Text="&#xE713;" Style="{StaticResource Icon}" />
                    <Button.ContextMenu>
                        <ContextMenu Placement="Bottom">
                            <MenuItem x:Name="DarkModeItem" Header="Giao diện tối" IsCheckable="True" Click="ThemeClick" />
                            <MenuItem x:Name="WrapItem" Header="Tự động xuống dòng" IsCheckable="True" Click="WrapClick" />
                            <Separator />
                            <MenuItem Header="Tăng cỡ chữ" Click="IncreaseFontClick" />
                            <MenuItem Header="Giảm cỡ chữ" Click="DecreaseFontClick" />
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
                <StackPanel x:Name="JsonTools" Orientation="Horizontal" DockPanel.Dock="Right"
                            VerticalAlignment="Center" Margin="4,0,8,0" Visibility="Collapsed">
                    <Button Content="Định dạng" Style="{StaticResource ToolButton}" Click="FormatJsonClick"
                            ToolTip="Định dạng JSON (Ctrl+Shift+I)" />
                    <Button Content="Thu gọn" Style="{StaticResource ToolButton}" Click="MinifyJsonClick"
                            ToolTip="Thu gọn JSON" />
                    <Button Content="Kiểm tra" Style="{StaticResource ToolButton}" Click="ValidateJsonClick"
                            ToolTip="Kiểm tra cú pháp JSON" />
                </StackPanel>
                <StackPanel x:Name="FileTools" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="NewFileButton" Style="{StaticResource ToolButton}" ToolTip="Tệp mới (Ctrl+N)" Click="NewClick">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE710;" Style="{StaticResource Icon}" Margin="0,0,7,0" />
                            <TextBlock Text="Mới" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Padding="4,5" ToolTip="Chọn loại tệp mới" AutomationProperties.Name="Chọn loại tệp mới"
                            Click="SettingsClick">
                        <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="9" Text="&#xE70D;" />
                        <Button.ContextMenu>
                            <ContextMenu Placement="Bottom">
                                <MenuItem Header="Văn bản (.txt)" Click="NewClick" />
                                <MenuItem Header="JSON (.json)" Click="NewJsonClick" />
                                <MenuItem Header="Markdown (.md)" Click="NewMarkdownClick" />
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                    <Button Style="{StaticResource ToolButton}" ToolTip="Mở tệp (Ctrl+O)" Click="OpenClick">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8E5;" Style="{StaticResource Icon}" Margin="0,0,7,0" />
                            <TextBlock Text="Mở" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Padding="4,5" ToolTip="Tệp gần đây" AutomationProperties.Name="Tệp gần đây" Click="RecentClick">
                        <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="9" Text="&#xE70D;" />
                        <Button.ContextMenu><ContextMenu Placement="Bottom" /></Button.ContextMenu>
                    </Button>
                    <Button Style="{StaticResource ToolButton}" ToolTip="Lưu tệp (Ctrl+S)" Command="ApplicationCommands.Save">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE74E;" Style="{StaticResource Icon}" Margin="0,0,7,0" />
                            <TextBlock Text="Lưu" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource IconButton}" ToolTip="Lưu thành (Ctrl+Shift+S)"
                            AutomationProperties.Name="Lưu thành" Click="SaveAsClick">
                        <TextBlock Text="&#xE792;" Style="{StaticResource Icon}" />
                    </Button>
                    <Button Padding="4,5" ToolTip="Tùy chọn lưu" AutomationProperties.Name="Tùy chọn lưu"
                            Click="SettingsClick">
                        <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="9" Text="&#xE70D;" />
                        <Button.ContextMenu>
                            <ContextMenu Placement="Bottom">
                                <MenuItem Header="Lưu tất cả" InputGestureText="Ctrl+Alt+S" Click="SaveAllClick" />
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                    <Border Margin="4,6" Width="1" Background="{DynamicResource BorderSubtleBrush}" />
                    <Button x:Name="UndoButton" Style="{StaticResource IconButton}" ToolTip="Hoàn tác (Ctrl+Z)"
                            AutomationProperties.Name="Hoàn tác" Click="UndoClick">
                        <TextBlock Text="&#xE7A7;" Style="{StaticResource Icon}" />
                    </Button>
                    <Button x:Name="RedoButton" Style="{StaticResource IconButton}" ToolTip="Làm lại (Ctrl+Y)"
                            AutomationProperties.Name="Làm lại" Click="RedoClick">
                        <TextBlock Text="&#xE7A6;" Style="{StaticResource Icon}" />
                    </Button>
                    <Button Style="{StaticResource IconButton}" ToolTip="Tìm (Ctrl+F) · Thay chữ (Ctrl+H)"
                            AutomationProperties.Name="Tìm" Click="FindClick">
                        <TextBlock Text="&#xE721;" Style="{StaticResource Icon}" />
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,0,0,1" Padding="12,5,12,0">
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" ToolTip="Tệp mới (Ctrl+N)"
                        AutomationProperties.Name="Thêm tab" Click="NewClick" VerticalAlignment="Top">
                    <TextBlock Text="&#xE710;" Style="{StaticResource Icon}" />
                </Button>
                <ListBox x:Name="Tabs" Background="Transparent" BorderThickness="0" Padding="0"
                         PreviewMouseWheel="TabsMouseWheel"
                         SelectionChanged="TabChanged" ScrollViewer.VerticalScrollBarVisibility="Disabled"
                         ScrollViewer.CanContentScroll="False"
                         ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                         AutomationProperties.Name="Tài liệu đang mở">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
                            <Setter Property="ToolTip" Value="{Binding ToolTip}" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Body" Background="Transparent" CornerRadius="6,6,0,0"
                                                Margin="0,0,3,0" Padding="10,0,3,0"
                                                BorderThickness="0,0,0,2" BorderBrush="Transparent">
                                            <ContentPresenter VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Body" Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
                                                <Setter TargetName="Body" Property="Background" Value="{DynamicResource EditorBackgroundBrush}" />
                                                <Setter TargetName="Body" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="6" Height="6" Margin="0,0,7,0" Fill="{DynamicResource AccentBrush}">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsDirty}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock Text="{Binding Name}" MinWidth="63" MaxWidth="167"
                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                <Button Content="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="10" MinWidth="27"
                                        MinHeight="26" Padding="5" Margin="6,0,0,0" Click="CloseTabClick"
                                        ToolTip="Đóng tab (Ctrl+W)" AutomationProperties.Name="Đóng tab" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <StackPanel Grid.Row="2">
        <Border x:Name="FindBar" Visibility="Collapsed" Padding="13,4"
                Background="{DynamicResource WindowBackgroundBrush}" BorderThickness="0,0,0,1"
                BorderBrush="{DynamicResource BorderSubtleBrush}">
            <StackPanel>
                <DockPanel LastChildFill="False">
                    <Button x:Name="CloseFindButton" DockPanel.Dock="Right" Content="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                            ToolTip="Đóng tìm kiếm (Esc)" AutomationProperties.Name="Đóng tìm kiếm" Click="CloseFindClick" />
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Tìm" Style="{StaticResource FindLabel}" />
                        <TextBox x:Name="FindQuery" Style="{StaticResource FindField}"
                                 AutomationProperties.Name="Từ cần tìm" KeyDown="FindQueryKeyDown" />
                        <Button Content="&#xE70E;" FontFamily="Segoe MDL2 Assets" ToolTip="Kết quả trước (Shift+F3)"
                                AutomationProperties.Name="Kết quả trước" Click="FindPreviousClick" />
                        <Button x:Name="FindNextButton" Content="&#xE70D;" FontFamily="Segoe MDL2 Assets" ToolTip="Kết quả tiếp (F3)"
                                AutomationProperties.Name="Kết quả tiếp" Click="FindNextClick" />
                        <TextBlock x:Name="FindMessage" Foreground="{DynamicResource SecondaryTextBrush}"
                                   VerticalAlignment="Center" Margin="8,0" AutomationProperties.LiveSetting="Polite" />
                    </StackPanel>
                </DockPanel>
                <StackPanel x:Name="ReplaceRow" Orientation="Horizontal" Visibility="Collapsed" Margin="0,4,0,0">
                    <TextBlock Text="Thay bằng" Style="{StaticResource FindLabel}" />
                    <TextBox x:Name="ReplaceQuery" Style="{StaticResource FindField}"
                             AutomationProperties.Name="Thay bằng" KeyDown="ReplaceQueryKeyDown"
                             ToolTip="Để trống nếu muốn xóa chữ tìm được." />
                    <Button x:Name="ReplaceOneButton" Content="Thay" Style="{StaticResource ToolButton}"
                            Click="ReplaceOneClick" ToolTip="Thay một chỗ rồi tìm chỗ tiếp theo." />
                    <Button x:Name="ReplaceAllButton" Content="Thay tất cả" Style="{StaticResource ToolButton}"
                            Click="ReplaceAllClick" ToolTip="Thay tất cả chỗ khớp trong tab hiện tại." />
                </StackPanel>
            </StackPanel>
        </Border>
        <Border x:Name="NoticeBar" Visibility="Collapsed" Padding="15,4,10,4"
                Background="{DynamicResource SurfaceBrush}">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="&#xE711;" FontFamily="Segoe MDL2 Assets"
                        FontSize="10" MinHeight="24" Padding="7,2" Click="ClearNoticeClick"
                        ToolTip="Đóng thông báo" AutomationProperties.Name="Đóng thông báo" />
                <TextBlock x:Name="NoticeText" VerticalAlignment="Center" TextWrapping="Wrap"
                           AutomationProperties.LiveSetting="Polite" />
            </DockPanel>
        </Border>
        </StackPanel>

        <ae:TextEditor Grid.Row="3" x:Name="Editor" Padding="14,11,14,10"
                       Background="{DynamicResource EditorBackgroundBrush}" BorderThickness="0"
                       Foreground="{DynamicResource PrimaryTextBrush}"
                       LineNumbersForeground="{DynamicResource SecondaryTextBrush}"
                       ShowLineNumbers="True" FontFamily="Cascadia Mono, Consolas"
                       HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                       AutomationProperties.Name="Văn bản" PreviewMouseLeftButtonDown="MarkdownLinkClick" />

        <Border Grid.Row="4" BorderBrush="{DynamicResource BorderSubtleBrush}"
                BorderThickness="0,1,0,0" Padding="16,0"
                TextElement.Foreground="{DynamicResource SecondaryTextBrush}" TextElement.FontSize="12">
            <DockPanel>
                <TextBlock x:Name="SaveStatus" DockPanel.Dock="Right" VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="PositionStatus" Style="{StaticResource StatusText}" />
                    <TextBlock x:Name="CountStatus" Style="{StaticResource StatusText}" />
                    <TextBlock x:Name="EncodingStatus" Style="{StaticResource StatusText}" />
                    <TextBlock x:Name="KindStatus" Style="{StaticResource StatusText}" />
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
