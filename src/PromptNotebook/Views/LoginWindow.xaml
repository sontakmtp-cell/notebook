<Window x:Class="PromptNotebook.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Đăng nhập — Prompt Notebook"
        Width="390" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" FontFamily="Segoe UI"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}">
    <StackPanel Margin="24">
        <TextBlock Text="Prompt Notebook" FontSize="23" FontWeight="SemiBold" />
        <TextBlock Text="Nhập mật khẩu để mở sổ prompt của bạn."
                   Margin="0,8,0,20" Foreground="{DynamicResource SecondaryTextBrush}" />
        <TextBlock Text="Mật khẩu" Margin="0,0,0,6" />
        <PasswordBox x:Name="PasswordInput" FontSize="16" Padding="8"
                     Background="{DynamicResource SurfaceBrush}"
                     Foreground="{DynamicResource PrimaryTextBrush}"
                     CaretBrush="{DynamicResource PrimaryTextBrush}"
                     BorderBrush="{DynamicResource BorderSubtleBrush}"
                     PasswordChanged="PasswordInput_PasswordChanged" />
        <TextBlock x:Name="ErrorText" Text="Mật khẩu chưa đúng. Thử lại nhé."
                   Visibility="Collapsed" Margin="0,8,0,0" Foreground="{DynamicResource SecondaryTextBrush}" />
        <Button Content="Đăng nhập" IsDefault="True" Click="LoginButton_Click"
                Margin="0,18,0,0" Padding="12,9" FontWeight="SemiBold"
                Background="{DynamicResource AccentBrush}" Foreground="White" BorderThickness="0" />
        <Button Content="Thoát" IsCancel="True" Margin="0,8,0,0" Padding="12,7"
                Background="{DynamicResource SurfaceBrush}"
                Foreground="{DynamicResource PrimaryTextBrush}"
                BorderBrush="{DynamicResource BorderSubtleBrush}" />
    </StackPanel>
</Window>
