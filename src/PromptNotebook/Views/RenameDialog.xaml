<Window x:Class="PromptNotebook.Views.RenameDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Đổi tên &amp; Danh mục Prompt"
        Width="480"
        Height="240"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        FontFamily="Segoe UI"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Tên prompt:"
                   FontSize="13"
                   FontWeight="SemiBold"
                   Margin="0,0,0,6" />

        <TextBox x:Name="TitleTextBox"
                 Grid.Row="1"
                 FontSize="14"
                 Padding="8,6"
                 Background="{DynamicResource SurfaceBrush}"
                 Foreground="{DynamicResource PrimaryTextBrush}"
                 CaretBrush="{DynamicResource PrimaryTextBrush}"
                 BorderBrush="{DynamicResource BorderSubtleBrush}"
                 BorderThickness="1" />

        <TextBlock Grid.Row="2"
                   Text="Danh mục:"
                   FontSize="13"
                   FontWeight="SemiBold"
                   Margin="0,12,0,6" />

        <TextBox x:Name="CategoryTextBox"
                 Grid.Row="3"
                 FontSize="13"
                 Padding="8,5"
                 Background="{DynamicResource SurfaceBrush}"
                 Foreground="{DynamicResource PrimaryTextBrush}"
                 CaretBrush="{DynamicResource PrimaryTextBrush}"
                 BorderBrush="{DynamicResource BorderSubtleBrush}"
                 BorderThickness="1" />

        <StackPanel Grid.Row="5"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,14,0,0">
            <Button Content="Hủy (Esc)"
                    Width="95"
                    Height="32"
                    Margin="0,0,8,0"
                    IsCancel="True"
                    Background="{DynamicResource SurfaceBrush}"
                    Foreground="{DynamicResource PrimaryTextBrush}"
                    BorderBrush="{DynamicResource BorderSubtleBrush}"
                    Click="CancelButton_Click" />
            <Button Content="Lưu (Enter)"
                    Width="105"
                    Height="32"
                    IsDefault="True"
                    Background="{DynamicResource AccentBrush}"
                    Foreground="White"
                    BorderThickness="0"
                    FontWeight="SemiBold"
                    Click="SaveButton_Click" />
        </StackPanel>
    </Grid>
</Window>
